{
  "format": "replay-component-pack",
  "formatVersion": "0.1",
  "id": "local.starter-dialogue",
  "name": "自制对白框入门包",
  "version": "0.1.0",
  "description": "可加载的声明式对白框与装饰模板。系统字体，零外部资源。",
  "resources": [],
  "components": [
    {
      "id": "dialogue-with-name",
      "name": "对白框与姓名栏",
      "kind": "dialogue-ui",
      "designSize": {"width": 880, "height": 160},
      "scaleMode": "uniform",
      "visibility": "when-active-dialogue",
      "elements": [
        {"id": "body-panel", "type": "panel", "rect": {"x": 0, "y": 28, "width": 880, "height": 132}, "fill": "#17243B", "opacity": 0.94, "radius": 16, "borderColor": "#90B8EF", "borderWidth": 2},
        {"id": "name-panel", "type": "panel", "rect": {"x": 22, "y": 0, "width": 180, "height": 42}, "fill": "#315989", "opacity": 1, "radius": 10, "borderColor": "#90B8EF", "borderWidth": 1},
        {"id": "speaker", "type": "text", "rect": {"x": 34, "y": 7, "width": 156, "height": 32}, "binding": "activeDialogue.speakerName", "fontFamily": "Microsoft YaHei", "fontSize": 20, "lineHeight": 1.2, "color": "#FFFFFF", "align": "center"},
        {"id": "body", "type": "text", "rect": {"x": 24, "y": 53, "width": 832, "height": 88}, "binding": "activeDialogue.text", "fontFamily": "Microsoft YaHei", "fontSize": 26, "lineHeight": 1.5, "color": "#F0F5FF", "align": "left", "reveal": "active-dialogue-progress"}
      ]
    },
    {
      "id": "corner-label",
      "name": "角标装饰（纯色示例）",
      "kind": "decoration",
      "designSize": {"width": 220, "height": 44},
      "scaleMode": "uniform",
      "visibility": "instance-range",
      "elements": [
        {"id": "label-panel", "type": "panel", "rect": {"x": 0, "y": 0, "width": 220, "height": 44}, "fill": "#315989", "opacity": 0.9, "radius": 8},
        {"id": "label-text", "type": "text", "rect": {"x": 12, "y": 8, "width": 196, "height": 28}, "text": "第一章 · 窗边", "fontFamily": "Microsoft YaHei", "fontSize": 20, "lineHeight": 1.2, "color": "#FFFFFF", "align": "left"}
      ]
    }
  ]
}
